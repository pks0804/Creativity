// =====================================================================
// Firestore 보안 규칙 (Firebase 콘솔 → Firestore → 규칙 탭에 그대로 붙여넣고 "게시")
//
// 이 파일은 "누가 어떤 데이터를 읽고 쓸 수 있는지"를 Firebase 서버가 직접 검사하는 규칙입니다.
// 화면에서 버튼을 숨기는 것만으로는 막을 수 없는 접근을 여기서 막습니다.
//
// 규칙 요약
//  1) 연구 자료·수업 자료는 누구나(로그인 없이) 읽을 수 있습니다.
//     등록·수정·삭제는 admin(교수)만 할 수 있습니다.
//  2) 댓글(토론)은 allowedEmails 명단에 등록된 구성원만 읽고 쓸 수 있습니다.
//     작성은 "본인 명의로만", 삭제는 본인 댓글이거나 admin일 때만 가능합니다.
//
// 준비 방법: Firestore에 allowedEmails 컬렉션을 만들고,
//   문서 ID = 구성원의 구글 이메일(소문자),  필드 role = "admin" 또는 "member"
//   예) allowedEmails/professor@gmail.com  →  { role: "admin" }
// =====================================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function allowedDoc() {
      return /databases/$(database)/documents/allowedEmails/$(myEmail());
    }

    // 등록된 구성원인지 (구글 계정 이메일 인증 완료 + 명단에 있음)
    function isMember() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(allowedDoc());
    }

    function isAdmin() {
      return isMember() && get(allowedDoc()).data.role == 'admin';
    }

    // 구성원 명단: 본인 항목은 본인이 읽을 수 있고(내 권한 확인용), 관리는 admin만
    match /allowedEmails/{email} {
      allow read: if isAdmin() || (signedIn() && email == myEmail());
      allow write: if isAdmin();
    }

    match /research/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /lectures/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /comments/{id} {
      allow read: if isMember();

      // 작성자 id를 다른 사람으로 속여서 쓰지 못하게 검사합니다.
      allow create: if isMember()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;

      // 댓글 수정 기능은 없으므로 막아 둡니다.
      allow update: if false;

      allow delete: if isAdmin()
        || (isMember() && resource.data.authorId == request.auth.uid);
    }
  }
}
